{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halftone",
  "version": "0.1.0",
  "identifier": "com.trapston3.halftone",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "widget",
        "url": "index.html",
        "title": " ",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "minWidth": 380,
        "minHeight": 216,
        "shadow": false,
        "skipTaskbar": true,
        "dragDropEnabled": false,
        "center": true,
        "width": 400,
        "height": 254
      },
      {
        "label": "main",
        "url": "main.html",
        "title": "Halftone",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": false,
        "dragDropEnabled": false,
        "center": true,
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' blob: flac: http://flac.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
