{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halftone",
  "version": "0.2.2",
  "identifier": "com.trapston3.halftone",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "widget",
        "url": "index.html",
        "title": " ",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "minWidth": 240,
        "minHeight": 140,
        "shadow": false,
        "skipTaskbar": true,
        "dragDropEnabled": false,
        "center": true,
        "width": 400,
        "height": 260
      },
      {
        "label": "main",
        "url": "main.html",
        "title": "Halftone",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": false,
        "dragDropEnabled": false,
        "center": true,
        "width": 1200,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://media.localhost media: http://flac.localhost; img-src 'self' data: blob: http://media.localhost media:; media-src 'self' blob: flac: media: http://flac.localhost http://media.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
